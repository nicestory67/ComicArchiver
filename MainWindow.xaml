<hc:Window x:Class="ComicArchiver.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="漫画打包工具"
           Icon="icons8_moleskine.ico"
           SizeToContent="Height" Width="580"
           ResizeMode="CanMinimize"
           WindowStartupLocation="CenterScreen"
           ShowTitle="True"
           Background="{DynamicResource RegionBrush}"
           AllowDrop="True" PreviewDrop="Window_Drop" PreviewDragOver="Window_DragOver">
    
    <hc:Window.NonClientAreaContent>
        <Grid>
            <TextBlock x:Name="TxtTitleVersion" Text="" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
            <ToggleButton x:Name="ToggleThemeCommand"
                IsChecked="True"
                ToolTip="切换明亮/暗黑主题"
                Cursor="Hand"
                Margin="0,0,5,0"
                HorizontalAlignment="Right"
                Style="{StaticResource ToggleButtonIconTransparent}"
                hc:IconSwitchElement.Geometry="{StaticResource EyeOpenGeometry}"
                hc:IconSwitchElement.GeometrySelected="{StaticResource EyeCloseGeometry}"
                Click="ToggleThemeCommand_Click" />
        </Grid>
    </hc:Window.NonClientAreaContent>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Mode & Path Card -->

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <hc:TextBox x:Name="TxtTargetDir" Grid.Column="0" Margin="0,0,8,0" hc:InfoElement.Placeholder="请选择或拖拽目标文件夹..." hc:InfoElement.ShowClearButton="True" TextChanged="TxtTargetDir_TextChanged"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览..." Width="80" Margin="0,0,8,0" Cursor="Hand" Click="BtnBrowse_Click" />
                <Button x:Name="BtnOpenFolder" Grid.Column="2" Content="📁 打开目录" Cursor="Hand" Click="BtnOpenFolder_Click" />
            </Grid>

            <Grid Grid.Row="1"> 
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtDragHint" Text="💡 提示：请拖入单个文件夹或点击 [浏览...] 选择" Style="{StaticResource TextBlockDefault}" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <hc:UniformSpacingPanel Spacing="10">
                        <TextBlock Text="打包输出格式：" Style="{StaticResource TextBlockDefault}" />
                        <RadioButton x:Name="RbCbz" Content="CBZ" IsChecked="True" Cursor="Hand" />
                        <RadioButton x:Name="RbZip" Content="ZIP" Cursor="Hand" />
                    </hc:UniformSpacingPanel>
                </StackPanel>
            </Grid>

            <hc:Divider Grid.Row="2" Margin="0,5" Visibility="Hidden" />
            
            <!-- Options Card -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Format & Options -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkDeleteOriginal" Content="清理原文件/文件夹" IsChecked="True" Cursor="Hand" />
                </StackPanel>

                <!-- Additional Include Pattern -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <hc:TextBox x:Name="TxtAdditionalInclude"
                        Width="300"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.Placeholder="*.xml"
                        hc:InfoElement.Title="额外包含文件："
                        ToolTip="支持通配符，多个文件名用分号分隔"
                        Text="*.xml"/>
                </StackPanel>
            </Grid>

            <hc:Divider Grid.Row="4" Margin="0,10" />

            <!-- Progress & Log Card -->
            <Grid Grid.Row="5" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="准备就绪" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource TextBlockDefault}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="线程:" VerticalAlignment="Center" Margin="0,0,5,0" Style="{StaticResource TextBlockDefault}"/>
                    <hc:NumericUpDown x:Name="NumThreads" Minimum="1" Maximum="32" Value="10" Margin="0,0,10,0" Style="{StaticResource NumericUpDown.Small}" ToolTip="并发处理线程数 (1-32，默认 10)" ValueChanged="NumThreads_ValueChanged" Width="50" />
                    <TextBlock Text="日志过滤:" VerticalAlignment="Center" Margin="0,0,5,0" Style="{StaticResource TextBlockDefault}"/>
                    <hc:ComboBox x:Name="CmbLogLevelFilter" SelectedIndex="0" Cursor="Hand" ToolTip="日志过滤级别"  SelectionChanged="CmbLogLevelFilter_SelectionChanged" Style="{StaticResource ComboBox.Small}">
                        <ComboBoxItem Content="全部" />
                        <ComboBoxItem Content="信息" />
                        <ComboBoxItem Content="成功" />
                        <ComboBoxItem Content="警告" />
                        <ComboBoxItem Content="错误" />
                    </hc:ComboBox>
                </StackPanel>
            </Grid>

            <!-- Log Console -->
            <ListBox x:Name="LstLogs" Grid.Row="6" Height="170" Style="{StaticResource ListBox.Small}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="4,2"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="1" Padding="10,0,10,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkContextMenu" Content="添加到右键菜单" Margin="0,0,15,0" Cursor="Hand" Checked="ChkContextMenu_Checked" Unchecked="ChkContextMenu_Unchecked"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource ButtonDanger}" Padding="14,4" FontSize="12" Margin="0,0,8,0" IsEnabled="False" Cursor="Hand" Click="BtnCancel_Click" />
                    <hc:ProgressButton x:Name="BtnExtract" Content="📦 开始解压" Style="{StaticResource ProgressButtonSuccess}" Padding="16,4" FontSize="12" Margin="0,0,8,0" Cursor="Hand" Click="BtnExtract_Click" />
                    <hc:ProgressButton x:Name="BtnStart" Content="🚀 开始打包" Style="{StaticResource ProgressButtonPrimary}" Padding="16,4" FontSize="12" Cursor="Hand" Click="BtnStart_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
