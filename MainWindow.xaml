<hc:Window x:Class="ComicArchiver.MainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:hc="https://handyorg.github.io/handycontrol"
           Title="ComicArchiver - 漫画打包工具"
           Height="425" Width="580"
           ResizeMode="CanMinimize"
           WindowStartupLocation="CenterScreen"
           ShowTitle="True"
           Background="{DynamicResource RegionBrush}"
           AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Content -->
        <StackPanel Margin="10">

            <!-- Mode & Path Card -->
            <!-- Mode Selector -->
            <Grid>
                <TextBlock Text="模式:" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <hc:UniformSpacingPanel Spacing="15">
                        <RadioButton x:Name="RbModeSubFolders" Content="子目录模式" IsChecked="True" Checked="Mode_Changed"/>
                        <RadioButton x:Name="RbModeBatch" Content="批量模式" Checked="Mode_Changed"/>
                    </hc:UniformSpacingPanel>
                </StackPanel>
            </Grid>

            <Grid Margin="0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <hc:TextBox x:Name="TxtTargetDir" Grid.Column="0" Margin="0,0,8,0" hc:InfoElement.Placeholder="请选择或拖拽目标文件夹..." hc:InfoElement.ShowClearButton="True"/>
                <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览..." Width="100" Click="BtnBrowse_Click" />
            </Grid>
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtDragHint" Grid.Column="0" Text="💡 提示：可选择单个目录或拖入多个文件夹" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <hc:UniformSpacingPanel Spacing="10">
                        <TextBlock Text="目标格式：" />
                        <RadioButton x:Name="RbCbz" Content="CBZ" IsChecked="True" />
                        <RadioButton x:Name="RbZip" Content="ZIP" />
                    </hc:UniformSpacingPanel>
                </StackPanel>
            </Grid>

            <hc:Divider Margin="0,15" />
            
            <!-- Options Card -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Format & Options -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkDeleteOriginal" Content="成功后清理原文件夹" IsChecked="True" />
                </StackPanel>

                <!-- Exclude Pattern -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <hc:TextBox x:Name="TxtExclude"
                        Width="380"
                        hc:InfoElement.ShowClearButton="True"
                        hc:InfoElement.TitlePlacement="Left"
                        hc:InfoElement.Placeholder="排除通配符 (分号分隔):"
                        hc:InfoElement.Title="排除通配符 (分号分隔):"
                        Text="*.db"/>
                </StackPanel>
            </Grid>
            
            <hc:Divider Margin="0,15" />

            <!-- Progress & Log Card -->
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="准备就绪" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtPercentage" Text="0%" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <ProgressBar Style="{StaticResource ProgressBarFlat}" x:Name="ProgBar" Value="0" Maximum="100" Margin="0,10" />

                <!-- Log Console -->
                <ListBox x:Name="LstLogs" Height="105" Style="{StaticResource ListBox.Small}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,2"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>
        </StackPanel>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="1" Padding="16,10" Background="{DynamicResource RegionBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSummary" Text="就绪。" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnOpenFolder" Content="📁 打开目录" Style="{StaticResource ButtonDefault}" Padding="10,4" FontSize="11" Margin="0,0,8,0" Click="BtnOpenFolder_Click" />
                    <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource ButtonDanger}" Padding="14,4" FontSize="12" Margin="0,0,8,0" IsEnabled="False" Click="BtnCancel_Click" />
                    <Button x:Name="BtnStart" Content="🚀 开始打包" Style="{StaticResource ButtonPrimary}" Padding="16,4" FontSize="12" Click="BtnStart_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</hc:Window>
